# ReForge frontend — environment template
#
# Copy this file to `.env.local` and adjust as needed:
#
#     cp .env.example .env.local
#
# `.env.local` is git-ignored. Never commit real credentials — the ReForge
# frontend requires no API keys, tokens, or secrets of any kind. Every value
# below is a non-sensitive origin/URL.


# ---------------------------------------------------------------------------
# REFORGE_BACKEND_URL  (server-side only — NOT exposed to the browser)
# ---------------------------------------------------------------------------
# Origin of the frozen ReForge Fastify backend. Next.js rewrites `/health` and
# `/v1/*` to this origin (see next.config.ts), so the browser only ever talks
# to the frontend origin and no CORS configuration is needed on the backend.
#
# Default when unset: http://127.0.0.1:3000
REFORGE_BACKEND_URL=http://127.0.0.1:3000


# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL  (inlined into the browser bundle — must stay non-secret)
# ---------------------------------------------------------------------------
# Base URL the API client prefixes onto every request. Leave EMPTY to use
# same-origin relative paths and the rewrite proxy above — this is the
# recommended setup for both development and production.
#
# Only set this to an absolute origin when the backend is served from a
# different host that already sends the appropriate CORS headers, e.g.
#   NEXT_PUBLIC_API_URL=https://api.example.com
#
# Anything prefixed with NEXT_PUBLIC_ is publicly readable in the browser.
# Never place a secret here.
NEXT_PUBLIC_API_URL=
